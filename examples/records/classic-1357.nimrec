# rs-nim record v1
# The classic 1-3-5-7 layout has nim-sum 0, so the first player is losing.
# Bob answers every move by restoring nim-sum 0 and wins.
rule  = normal
first = human
heaps = 1 3 5 7
human = Alice
cpu   = Bob

D 2   # 1 3 5 5
B 2   # 1 1 5 5  (nim-sum 0)
C 3   # 1 1 2 5
D 3   # 1 1 2 2  (nim-sum 0)
A 1   # 0 1 2 2
B 1   # 0 0 2 2  (nim-sum 0)
C 1   # 0 0 1 2
D 1   # 0 0 1 1  (nim-sum 0)
C 1   # 0 0 0 1
D 1   # 0 0 0 0  Bob takes the last stone
